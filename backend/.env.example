# KeyFlow Backend Environment Configuration
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=4000
NODE_ENV=development

# Security - JWT Configuration
# CRITICAL: Generate a strong secret for production
# Example: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=24h

# Database Configuration
#
# By default (nothing set below) the backend uses a local SQLite file at DB_PATH. This is
# fine for development, but on most hosting platforms (including Render's free tier) the
# filesystem is ephemeral, so that data is lost on every redeploy/restart.
#
# To use real, persistent Postgres instead (e.g. a free Supabase project), set DATABASE_URL to
# its connection string and leave DB_PATH as a harmless, unused fallback:
#   1. Create a project at https://supabase.com, then go to
#      Project Settings -> Database -> Connection string -> URI
#      (use the "Transaction" pooler connection string for serverless/many-short-lived-
#      connections hosting like Render; use the direct connection for a long-running server).
#   2. DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
#   3. Leave DATABASE_SSL unset/true (Supabase requires SSL).
#
# Check it's actually live once deployed: GET /health should show
#   "database": { "driver": "postgres", "connected": true }
DB_PATH=./look_system.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=true

# Authentication Security
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Data Retention
DEFAULT_RETENTION_DAYS=90

# CORS Configuration
# Comma-separated list of allowed origins or * for all
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Production deployment
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
